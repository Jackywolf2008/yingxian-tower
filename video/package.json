{
  "name": "yingxian-tower-video",
  "private": true,
  "description": "用 Remotion 制作的《应县木塔》介绍视频",
  "type": "module",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "images": "node scripts/copy-images.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "music": "node scripts/make-music.mjs",
    "prepare-assets": "npm run capture && npm run images && npm run fonts && npm run music",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/yingxian-tower-intro.mp4",
    "poster": "remotion still src/index.ts Intro out/intro-poster.jpg --frame=290 --image-format=jpeg --jpeg-quality=85",
    "page": "node scripts/build-page.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "playwright": "1.56.1",
    "typescript": "5.9.2"
  }
}
